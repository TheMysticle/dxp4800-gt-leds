$cfgFile = '/boot/config/plugins/dxp4800-gt-leds/settings.cfg';
$cfgDir = dirname($cfgFile);
if (!is_dir($cfgDir)) {
    mkdir($cfgDir, 0755, true);
}

$cfgDefaults = array(
  'MASTER_LED_SWITCH' => '1',
  'SCHEDULE_ENABLE' => '0',
  'SCHEDULE_START_TIME' => '08:00',
  'SCHEDULE_END_TIME' => '22:00',
  'HA_API_ENABLE' => '0',
  'HA_API_PORT' => '8088',
  'NETWORK_INTERFACE' => 'eth0',
  'DISK_LED_INVERT' => '1',
  'COLOR_DISK_HEALTH' => '255 255 255',
  'BRIGHTNESS_DISK_LEDS' => '255',
  'POWER_LED_MODE' => 'auto',
  'POWER_LED_COLOR' => '255 255 255',
  'NETDEV_LED_MODE' => 'auto',
  'NETDEV_LED_COLOR' => '255 255 255',
  'BAY_DISK1_MODE' => 'auto',
  'BAY_DISK1_COLOR' => '255 255 255',
  'BAY_DISK2_MODE' => 'auto',
  'BAY_DISK2_COLOR' => '255 255 255',
  'BAY_DISK3_MODE' => 'auto',
  'BAY_DISK3_COLOR' => '255 255 255',
  'BAY_DISK4_MODE' => 'auto',
  'BAY_DISK4_COLOR' => '255 255 255',
);

$cfg = array();
if (file_exists($cfgFile)) {
    $parsed = @parse_ini_file($cfgFile);
    if (is_array($parsed)) $cfg = $parsed;
}
$cfg = array_merge($cfgDefaults, $cfg);

if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    if (isset($_POST['apply'])) {
        $new = $cfg;
        $fields = array('MASTER_LED_SWITCH', 'SCHEDULE_ENABLE', 'SCHEDULE_START_TIME', 'SCHEDULE_END_TIME',
                        'HA_API_ENABLE', 'HA_API_PORT', 'NETWORK_INTERFACE', 'DISK_LED_INVERT', 
                        'COLOR_DISK_HEALTH', 'BRIGHTNESS_DISK_LEDS',
                        'POWER_LED_MODE', 'POWER_LED_COLOR', 'NETDEV_LED_MODE', 'NETDEV_LED_COLOR',
                        'BAY_DISK1_MODE', 'BAY_DISK1_COLOR', 'BAY_DISK2_MODE', 'BAY_DISK2_COLOR',
                        'BAY_DISK3_MODE', 'BAY_DISK3_COLOR', 'BAY_DISK4_MODE', 'BAY_DISK4_COLOR');
        foreach ($fields as $field) {
            if (isset($_POST[$field])) {
                $new[$field] = trim($_POST[$field]);
            }
        }
        $out = "";
        foreach ($new as $k => $v) {
            $out .= "$k=\"$v\"\n";
        }
        file_put_contents($cfgFile, $out);
        touch('/var/run/dxp4800-gt-leds-reload');
        
        // Also restart the rc script so the API daemon can spin up/down if toggled
        exec("/etc/rc.d/rc.dxp4800-gt-leds restart > /dev/null 2>&1 &");
        
        echo '<script>window.location.href = window.location.pathname + window.location.search;</script>';
        exit;
    }
}

function hex2rgb($hex) {
    $hex = str_replace('#', '', $hex);
    if(strlen($hex) == 3) {
        $r = hexdec(substr($hex,0,1).substr($hex,0,1));
        $g = hexdec(substr($hex,1,1).substr($hex,1,1));
        $b = hexdec(substr($hex,2,1).substr($hex,2,1));
    } else {
        $r = hexdec(substr($hex,0,2));
        $g = hexdec(substr($hex,2,2));
        $b = hexdec(substr($hex,4,2));
    }
    return "$r $g $b";
}
function rgb2hex($rgb) {
    $parts = explode(' ', $rgb);
    if (count($parts) != 3) return '#ffffff';
    return sprintf("#%02x%02x%02x", $parts[0], $parts[1], $parts[2]);
}
