<script>
function hexToRgbStr(hex) {
    var result = /^#?([a-f\d]{2})([a-f\d]{2})([a-f\d]{2})$/i.exec(hex);
    return result ? 
        parseInt(result[1], 16) + ' ' + parseInt(result[2], 16) + ' ' + parseInt(result[3], 16) : '255 255 255';
}

function updateGlobalColor(hex) {
    document.getElementById('global-color-rgb').value = hexToRgbStr(hex);
}

function updateBayColor(bayId, hex) {
    document.getElementById('bay-color-rgb-' + bayId).value = hexToRgbStr(hex);
    updateBayVisuals(bayId);
}

function updateBayVisuals(bayId) {
    var mode = document.getElementById('bay-mode-' + bayId).value;
    var colorHex = document.getElementById('bay-color-picker-' + bayId).value;
    var led = document.getElementById('led-indicator-' + bayId);
    
    if (mode === 'force_off') {
        led.style.background = '#333';
        led.style.boxShadow = 'none';
    } else {
        led.style.background = colorHex;
        led.style.boxShadow = '0 0 10px ' + colorHex;
    }
}

function toggleSchedule(val) {
    document.getElementById('schedule-times').style.display = (val === '1') ? 'block' : 'none';
}

function selectBay(bayId) {
    document.querySelectorAll('.interactive-led').forEach(function(el) {
        el.classList.remove('active-element');
    });
    document.querySelectorAll('.bay-settings').forEach(function(el) {
        el.style.display = 'none';
    });
    
    var selectedBay = document.querySelector('.interactive-led[data-id="' + bayId + '"]');
    if (selectedBay) {
        selectedBay.classList.add('active-element');
    }
    
    var settingsPanel = document.getElementById('bay-settings-' + bayId);
    if (settingsPanel) {
        settingsPanel.style.display = 'block';
        settingsPanel.scrollIntoView({behavior: "smooth", block: "center"});
    }
}
</script>
